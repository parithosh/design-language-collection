    "list.inactiveSelectionBackground": "#1f2221",
    "list.hoverBackground": "#1c1f1d",
    "titleBar.activeBackground": "#121514",
    "titleBar.activeForeground": "#d0d5d1",
    "titleBar.inactiveBackground": "#121514",
    "titleBar.inactiveForeground": "#828c88",
    "titleBar.border": "#262b29",
    "statusBar.background": "#121514",
    "statusBar.foreground": "#828c88",
    "statusBar.border": "#262b29",
    "statusBar.noFolderBackground": "#121514",
    "panel.background": "#161918",
    "panel.border": "#262b29",
    "panelTitle.activeForeground": "#d0d5d1",
    "panelTitle.activeBorder": "#91bfb3",
    "panelTitle.inactiveForeground": "#828c88",
    "terminal.background": "#161918",
    "terminal.foreground": "#d0d5d1",
    "terminalCursor.foreground": "#91bfb3",
    "terminal.ansiBlack": "#121514",
    "terminal.ansiBrightBlack": "#828c88",
    "terminal.ansiRed": "#d68f87",
    "terminal.ansiBrightRed": "#e8a19a",
    "terminal.ansiGreen": "#a6bf93",
    "terminal.ansiBrightGreen": "#bacfa3",
    "terminal.ansiYellow": "#c7bd88",
    "terminal.ansiBrightYellow": "#dad198",
    "terminal.ansiBlue": "#94b0d2",
    "terminal.ansiBrightBlue": "#a6c1e5",
    "terminal.ansiMagenta": "#baa1c5",
    "terminal.ansiBrightMagenta": "#cab3d7",
    "terminal.ansiCyan": "#91bfb3",
    "terminal.ansiBrightCyan": "#a1d1c4",
    "terminal.ansiWhite": "#d0d5d1",
    "terminal.ansiBrightWhite": "#dbe0dc",
    "gitDecoration.modifiedResourceForeground": "#c7bd88",
    "gitDecoration.untrackedResourceForeground": "#a6bf93",
    "gitDecoration.addedResourceForeground": "#a6bf93",
    "gitDecoration.deletedResourceForeground": "#f0806f",
    "gitDecoration.ignoredResourceForeground": "#828c88",
    "scrollbarSlider.background": "#2c302e99",
    "scrollbarSlider.hoverBackground": "#3b3f3d99"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#828c88",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#91bfb3"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a6bf93"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d6a07a"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#baa1c5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#d6a07a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#94b0d2"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#d0d5d1"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d0d5d1"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d0d5d1"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#828c88"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d68f87"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c7bd88"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f0806f"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#d0d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d0d5d1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d0d5d1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#91bfb3"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a6bf93"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f0806f"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#c7bd88"
      }
    }
  ]
}
