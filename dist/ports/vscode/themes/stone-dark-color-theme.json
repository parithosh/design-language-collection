{
  "$comment": "Generated by build.mjs from tokens/. Do not edit by hand.",
  "name": "Stone Slate",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#d0d5d1",
    "descriptionForeground": "#828c88",
    "focusBorder": "#91bfb3",
    "widget.border": "#262b29",
    "textLink.foreground": "#91bfb3",
    "textLink.activeForeground": "#91bfb3",
    "button.background": "#91bfb3",
    "button.foreground": "#161918",
    "badge.background": "#91bfb3",
    "badge.foreground": "#161918",
    "activityBarBadge.background": "#91bfb3",
    "activityBarBadge.foreground": "#161918",
    "input.background": "#161918",
    "input.border": "#262b29",
    "input.placeholderForeground": "#828c88",
    "dropdown.background": "#161918",
    "dropdown.border": "#262b29",
    "editor.background": "#161918",
    "editor.foreground": "#d0d5d1",
    "editorLineNumber.foreground": "#676f6c",
    "editorLineNumber.activeForeground": "#d0d5d1",
    "editor.lineHighlightBackground": "#1d211f",
    "editor.selectionBackground": "#2a3a36",
    "editor.findMatchHighlightBackground": "#463b31",
    "editorCursor.foreground": "#91bfb3",
    "editorWhitespace.foreground": "#343a38",
    "editorIndentGuide.background1": "#262b29",
    "editorIndentGuide.activeBackground1": "#343a38",
    "editorBracketMatch.background": "#2a3a36",
    "editorBracketMatch.border": "#343a38",
    "editorError.foreground": "#f0806f",
    "editorWarning.foreground": "#c7bd88",
    "editorInfo.foreground": "#94b0d2",
    "editorGutter.addedBackground": "#a6bf93",
    "editorGutter.modifiedBackground": "#c7bd88",
    "editorGutter.deletedBackground": "#f0806f",
    "diffEditor.insertedTextBackground": "#2c322a",
    "diffEditor.removedTextBackground": "#372825",
    "editorGroupHeader.tabsBackground": "#121514",
    "editorGroup.border": "#262b29",
    "tab.activeBackground": "#161918",
    "tab.activeForeground": "#d0d5d1",
    "tab.inactiveBackground": "#121514",
    "tab.inactiveForeground": "#828c88",
    "tab.border": "#262b29",
    "tab.activeBorderTop": "#91bfb3",
    "sideBar.background": "#121514",
    "sideBar.foreground": "#d0d5d1",
    "sideBar.border": "#262b29",
    "sideBarSectionHeader.background": "#121514",
    "sideBarTitle.foreground": "#828c88",
    "activityBar.background": "#121514",
    "activityBar.foreground": "#d0d5d1",
    "activityBar.inactiveForeground": "#828c88",
    "activityBar.border": "#262b29",
    "list.activeSelectionBackground": "#252827",
